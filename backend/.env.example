DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The web console's dev server origin (Milestone 7) — CORS_ALLOWED_ORIGINS
# is deliberately empty by default (see config/settings/base.py), so local
# frontend development needs this set explicitly, same as any other
# environment's real origin would be.
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=hospital_mis
POSTGRES_USER=hospital_mis
POSTGRES_PASSWORD=hospital_mis
# For a host-venv workflow against docker-compose's postgres/redis (default
# host-side ports below); inside docker-compose itself these are overridden
# to the internal service addresses (see docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_URL=redis://localhost:6379/0

# MFA secrets are encrypted at rest using this key (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_SECRET_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# djangorestframework-simplejwt lifetimes are set in code (TRD §4.3); this
# file intentionally carries no token-lifetime overrides.
